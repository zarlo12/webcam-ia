# =====================================================================
# Proveedor de generación de imagen
# =====================================================================
# "replicate" o "fal". Se cambia aquí y se redespliega: no toca prompts,
# composición ni frontend. Los dos corren el mismo modelo de Google
# (nano-banana 2), así que el resultado es equivalente.
#
# Para probar el otro sin redesplegar, se puede mandar provider=fal
# (o provider=replicate) en la petición a generateSummitImage.
IMAGE_PROVIDER=fal

# fal.ai — https://fal.ai/dashboard/keys   (formato id:secreto)
FAL_KEY=

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# =====================================================================
# Firebase
# =====================================================================
# OJO: es el bucket .firebasestorage.app, NO el .appspot.com.
STORAGE_BUCKET=imagen-ia-845a3.firebasestorage.app

NODE_ENV=production

# Token del panel de registros. Si se define, /panel exige ?token=...
# Si se deja vacío, el panel queda abierto.
PANEL_TOKEN=
