# =====================================================================
# Campaña Claro · "Antioquia nos enseña a llegar lejos" (Feria de las Flores)
# =====================================================================
# Única variable que necesita la app. Es opcional: si no se define, el código
# usa este mismo valor por defecto (src/services/feriaService.ts).
VITE_FERIA_FUNCTIONS_URL=https://us-central1-imagen-ia-845a3.cloudfunctions.net

# Para el emulador local de functions:
# VITE_FERIA_FUNCTIONS_URL=http://127.0.0.1:5001/imagen-ia-845a3/us-central1


# =====================================================================
# De aquí hacia abajo: variables de proyectos anteriores.
# Esta app ya no las lee (firebaseConfig.ts y aiImageService.ts quedaron
# huérfanos cuando la Cloud Function pasó a guardar la imagen ella misma).
# =====================================================================

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEFGHIJ

# Firebase Functions URL (for development)
VITE_FIREBASE_FUNCTIONS_URL=http://127.0.0.1:5001/your-project-id/us-central1

